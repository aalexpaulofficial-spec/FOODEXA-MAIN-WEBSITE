# =============================================================================
# FOODEXA - Required Environment Variables
# =============================================================================

# --- Supabase (Client-side) ---
# These are used by the browser for data fetching and auth.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Optional alternative (if your Supabase provides a publishable key)
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Supabase (Server-side) ---
# Service role key bypasses RLS. Used by server endpoints (validate-institution-code, etc.)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="the-same-anon-key-as-above"

# --- Razorpay Payment Gateway ---
# Get these from https://dashboard.razorpay.com
# Use test keys during development (rzp_test_...), live keys in production (rzp_live_...)
RAZORPAY_KEY_ID="rzp_live_TIpx9mJu1SlwD2"
RAZORPAY_KEY_SECRET="Y2Oz5eA568b04XymC3HC0ujE"

# Razorpay Webhook Secret (optional, for webhook verification)
# Configure at Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=""

# --- AI / Gemini ---
# Required for LX AI Assistant features
GEMINI_API_KEY="your-gemini-api-key"

# --- Application URL ---
# Used for self-referential links and OAuth callbacks
APP_URL="http://localhost:2000"

# --- Server ---
PORT=2000
NODE_ENV=development
